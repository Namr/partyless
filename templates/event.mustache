<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{event_name}} | Partyless</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="styles.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
</head>

<body>
  <div class="shell">
    <header>
      <div class="brand">
        <h1><a href="/">Partyless</a></h1>
      </div>
      <div class="tag">RSVPs without the BS</div>
    </header>

    <form id="uuid-form" style="display: none;">
      <input type="hidden" name="uuid" id="uuid-field" />
    </form>

    <main>
      <section class="card event-card">
        <div class="card-pane event-pane">
          <div>
            <h2 class="event-title">{{event_name}}</h2>
          </div>

          <div class="info-grid">
            <div class="info-block">
              <span class="info-label">Created by</span>
              <span class="info-value">{{hosts_name}}</span>
            </div>
            <div class="info-block">
              <span class="info-label">Location</span>
              <span class="info-value">{{address}}</span>
            </div>
          </div>

          <div class="info-block when-block">
            <span class="info-label">When</span>
            <p class="event-description" id="event-time">{{time}}</p>
          </div>

          <div class="info-block description-block">
            <span class="info-label">Details</span>
            <p class="event-description">{{description}}</p>
          </div>
        
          <div class="edit-button-meta">
              <button class="edit-button" hx-on:click="location.href='/edit_event.html?uuid=' + new URLSearchParams(window.location.search).get('uuid');">Edit Event</button>
          </div>
        </div>

        <div class="card-pane guest-pane">
          <form class="rsvp-form" hx-post="/rsvp" hx-include="[name='uuid']" hx-on::after-request="this.reset()" id="rsvp-form">
            <h3 class="rsvp-title">RSVP</h3>
            <div class="form-grid">
              <label class="form-field">
                <span class="info-label">Name</span>
                <input class="form-input" type="text" name="name" placeholder="Your name" autocomplete="off" maxlength="40" required />
              </label>

              <label class="form-field">
                <span class="info-label">Password <span class="optional-note">(optional)</span></span>
                <input class="form-input" type="password" name="password" placeholder="Set a password to edit later" autocomplete="off" minlength="5" maxlength="24"/>
              </label>

              <label class="form-field">
                <span class="info-label">Note <span class="optional-note">(optional)</span></span>
                <input class="form-input" type="text" name="note" placeholder="Message for the host" autocomplete="off" maxlength="90" />
              </label>
            </div>

            <div class="form-field form-field-centered">
              <span class="info-label">Will you attend?</span>
              <div class="rsvp-choices">
                <label class="choice-wrapper">
                  <input class="choice-input" type="radio" name="response" value="yes" required />
                  <span class="choice-label">Yes</span>
                </label>
                <label class="choice-wrapper">
                  <input class="choice-input" type="radio" name="response" value="no" />
                  <span class="choice-label">No</span>
                </label>
                <label class="choice-wrapper">
                  <input class="choice-input" type="radio" name="response" value="maybe" />
                  <span class="choice-label">Maybe</span>
                </label>
              </div>
            </div>

            <button class="submit-button" type="submit">Send RSVP</button>
            <div id="error-modal-container"></div>
          </form>

          <div class="guest-header">
            <h2>Guest List</h2>
            <span class="guest-count">{{yes_num}} Yes {{no_num}} No {{maybe_num}} Maybe</span>
          </div>

          <div class="guest-list-wrapper">
            <ul class="guest-list">
              {{#guests}}
              <li>
                <article class="guest-card">
                  <div class="guest-name">{{name}}</div>
                  <div class="guest-note-meta">
                    {{#note}}
                    <p class="guest-note">{{note}}</p>
                    {{/note}}
                    <div class="guest-meta">
                      <span class="guest-pill">{{status}}</span>
                    </div>
                  </div>
                  <div class="guest-edit-meta">
                    <p class="guest-edit-text"><a class="guest-edit-anchor" href="/edit_guest.html?guest_id={{id}}">edit</a></p>
                  </div>
                </article>
              </li>
              {{/guests}}
              {{^guests}}
              <li>
                <article class="guest-card empty">
                  Be the first to RSVP!
                </article>
              </li>
              {{/guests}}
            </ul>
          </div>

        </div>
      </section>
    </main>
  </div>
</body>

<script>
  document.body.addEventListener("htmx:responseError", function(evt) {
    let target = document.querySelector("#error-modal-container");
    htmx.swap(target, evt.detail.xhr.responseText, "innerHTML");
  });
  (function () {
    const params = new URLSearchParams(window.location.search);
    const uuidValue = params.get('uuid') || '';
    const uuidField = document.getElementById('uuid-field');
    if (uuidField) {
    uuidField.value = uuidValue;
    }

  })();
    document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("event-time");
    if (!el) return;
    const raw = el.textContent.trim();
    const date = new Date(raw);
    const formatter = new Intl.DateTimeFormat(undefined, {
        weekday: "long",
        month: "long",
        day: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        hour12: true       
    });
    el.textContent = formatter.format(date).replace(",", "");
  });
</script>

</html>
